@startuml
title Clipboard History ERD

entity "Entry" as Entry {
  * id : BIGINT
  --
  kind : ENUM('text','image','mixed')
  title : VARCHAR(255)
  language : VARCHAR(16)
  mimeType : VARCHAR(255)
  textFormat : VARCHAR(64)
  textContent : LONGBLOB
  imageBlob : LONGBLOB
  imageThumbnail : MEDIUMBLOB
  tags : JSON
  imageMetadata : JSON
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
  accessedAt : TIMESTAMP
}

entity "Tag" as Tag {
  * id : BIGINT
  --
  name : VARCHAR(64)
}

entity "EntryTag" as EntryTag {
  * entryId : BIGINT
  * tagId : BIGINT
}

entity "OCROutput" as OCROutput {
  * id : BIGINT
  --
  entryId : BIGINT
  language : VARCHAR(16)
  ocrText : LONGTEXT
}

Entry "1" -- "0..*" EntryTag : tag_map
Tag "1" -- "0..*" EntryTag : tag_map
Entry "0..1" -- "1" OCROutput : has_ocr

note bottom
  PCs/MCs:
  - Entry<->Tag is N:M via EntryTag (PC partial both).
  - OCROutput must link to exactly one Entry (PC total on OCROutput, MC 1);
    an Entry can have 0..1 OCROutput (only non-text entries run OCR; engine/script not stored).
end note

@enduml
